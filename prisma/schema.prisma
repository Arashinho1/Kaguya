generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  CHANNEL
  ROLE
  USER
}

enum CombatEncounterStatus {
  OPEN
  ACTIVE
  ENDED
}

model RpgGuild {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  prefix    String   @default(".")
  locale    String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings         GuildSetting[]
  permissions      GuildRolePermission[]
  auditLogs        AuditLog[]
  attributes       AttributeDefinition[]
  clans            Clan[]
  villages         Village[]
  ranks            RankDefinition[]
  jutsuTypes       JutsuType[]
  jutsus           JutsuDefinition[]
  characters       Character[]
  learnedJutsus    CharacterJutsu[]
  characterProgress CharacterProgress[]
  trainingLogs     TrainingLog[]
  jutsuUseLogs     JutsuUseLog[]
  combatEncounters CombatEncounter[]
  combatParticipants CombatParticipant[]
  combatActionLogs CombatActionLog[]

  @@map("rpg_guilds")
}

model GuildSetting {
  id          String          @id @default(cuid())
  guildId     String
  key         String
  label       String
  description String?
  value       Json
  valueType   ConfigValueType @default(JSON)
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("guild_settings")
}

model GuildRolePermission {
  id         String   @id @default(cuid())
  guildId    String
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId, permission])
  @@index([guildId])
  @@map("guild_role_permissions")
}

model AttributeDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  baseValue   Int      @default(0)
  minValue    Int      @default(0)
  maxValue    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("attribute_definitions")
}

model Clan {
  id           String   @id @default(cuid())
  guildId      String
  name         String
  description  String?
  bonuses      Json     @default("{}")
  restrictions Json     @default("{}")
  memberLimit  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("clans")
}

model Village {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("villages")
}

model RankDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  sortOrder   Int      @default(0)
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]
  requiredJutsus JutsuDefinition[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("rank_definitions")
}

model JutsuType {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  jutsus JutsuDefinition[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("jutsu_types")
}

model JutsuDefinition {
  id             String   @id @default(cuid())
  guildId        String
  key            String
  name           String
  description    String?
  typeId         String?
  requiredRankId String?
  chakraCost     Int      @default(0)
  jutsuRank      String?
  duration       String?
  usageLimit     Int?
  requirements   Json     @default("{}")
  metadata       Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guild        RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type         JutsuType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  requiredRank RankDefinition? @relation(fields: [requiredRankId], references: [id], onDelete: SetNull)
  learnedBy    CharacterJutsu[]
  useLogs      JutsuUseLog[]
  combatActionLogs CombatActionLog[]

  @@unique([guildId, key])
  @@index([guildId])
  @@index([typeId])
  @@index([requiredRankId])
  @@map("jutsu_definitions")
}

model Character {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  name       String
  clanId     String?
  villageId  String?
  rankId     String?
  attributes Json     @default("{}")
  metadata   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild   RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clan    Clan?           @relation(fields: [clanId], references: [id], onDelete: SetNull)
  village Village?        @relation(fields: [villageId], references: [id], onDelete: SetNull)
  rank    RankDefinition? @relation(fields: [rankId], references: [id], onDelete: SetNull)
  learnedJutsus CharacterJutsu[]
  progress      CharacterProgress?
  trainingLogs  TrainingLog[]
  jutsuUseLogs  JutsuUseLog[]
  combatParticipants CombatParticipant[]
  combatActionLogs CombatActionLog[]

  @@unique([guildId, name])
  @@index([guildId, userId])
  @@map("characters")
}

model CharacterJutsu {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  jutsuId     String
  learnedAt   DateTime @default(now())
  metadata    Json     @default("{}")

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jutsu     JutsuDefinition @relation(fields: [jutsuId], references: [id], onDelete: Cascade)

  @@unique([characterId, jutsuId])
  @@index([guildId, characterId])
  @@index([guildId, jutsuId])
  @@map("character_jutsus")
}

model CharacterProgress {
  id             String   @id @default(cuid())
  guildId        String
  characterId    String   @unique
  trainingPoints Int      @default(0)
  experience     Int      @default(0)
  currentChakra  Int?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId])
  @@map("character_progress")
}

model JutsuUseLog {
  id           String   @id @default(cuid())
  guildId      String
  characterId  String
  jutsuId      String
  actorId      String
  chakraCost   Int      @default(0)
  chakraBefore Int      @default(0)
  chakraAfter  Int      @default(0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jutsu     JutsuDefinition @relation(fields: [jutsuId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@index([guildId, jutsuId, createdAt])
  @@map("jutsu_use_logs")
}

model CombatEncounter {
  id        String                @id @default(cuid())
  guildId   String
  channelId String
  name      String
  status    CombatEncounterStatus @default(OPEN)
  round     Int                   @default(1)
  turnIndex Int                   @default(0)
  metadata  Json                  @default("{}")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  guild        RpgGuild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  participants CombatParticipant[]
  actionLogs   CombatActionLog[]

  @@index([guildId, channelId, status])
  @@index([guildId, updatedAt])
  @@map("combat_encounters")
}

model CombatParticipant {
  id          String   @id @default(cuid())
  guildId     String
  encounterId String
  characterId String
  userId      String
  initiative  Int      @default(0)
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  encounter CombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, characterId])
  @@index([guildId, userId])
  @@index([guildId, encounterId])
  @@map("combat_participants")
}

model CombatActionLog {
  id          String   @id @default(cuid())
  guildId     String
  encounterId String
  characterId String?
  jutsuId     String?
  actorId     String
  action      String
  summary     String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  guild     RpgGuild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  encounter CombatEncounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  jutsu     JutsuDefinition? @relation(fields: [jutsuId], references: [id], onDelete: SetNull)

  @@index([guildId, encounterId, createdAt])
  @@index([guildId, actorId, createdAt])
  @@map("combat_action_logs")
}

model TrainingLog {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  actorId     String
  action      String
  attributeKey String?
  amount      Int      @default(0)
  cost        Int      @default(0)
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@index([guildId, actorId, createdAt])
  @@map("training_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("audit_logs")
}
