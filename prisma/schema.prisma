generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  CHANNEL
  ROLE
  USER
}

model RpgGuild {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  prefix    String   @default(".")
  locale    String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    GuildSetting[]
  permissions GuildRolePermission[]
  auditLogs   AuditLog[]
  attributes  AttributeDefinition[]
  characters  Character[]
  clans       Clan[]
  villages    Village[]
  ranks       RankDefinition[]
  progress    CharacterProgress[]
  trainingLogs TrainingLog[]
  periciaDefinitions PericiaDefinition[]
  characterPericias  CharacterPericia[]
  periciaXpLogs      PericiaXpLog[]
  jutsuTypes         JutsuType[]
  jutsuDefinitions   JutsuDefinition[]
  learnedJutsus      CharacterJutsu[]
  jutsuUseLogs       JutsuUseLog[]
  duelEncounters     DuelEncounter[]
  itemDefinitions    ItemDefinition[]
  inventories        CharacterInventory[]
  currencyLogs       CurrencyLog[]

  @@map("rpg_guilds")
}

model GuildSetting {
  id          String          @id @default(cuid())
  guildId     String
  key         String
  label       String
  description String?
  value       Json
  valueType   ConfigValueType @default(JSON)
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("guild_settings")
}

model GuildRolePermission {
  id         String   @id @default(cuid())
  guildId    String
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId, permission])
  @@index([guildId])
  @@map("guild_role_permissions")
}

model AttributeDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  baseValue   Int      @default(0)
  minValue    Int      @default(0)
  maxValue    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("attribute_definitions")
}

model Character {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  name       String
  clanId     String?
  villageId  String?
  rankId     String?
  backgroundUrl String?
  attributes Json     @default("{}")
  metadata   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild   RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clan    Clan?           @relation(fields: [clanId], references: [id], onDelete: SetNull)
  village Village?        @relation(fields: [villageId], references: [id], onDelete: SetNull)
  rank    RankDefinition? @relation(fields: [rankId], references: [id], onDelete: SetNull)
  progress          CharacterProgress?
  trainingLogs      TrainingLog[]
  periciaProgress   CharacterPericia[]
  periciaXpLogs     PericiaXpLog[]
  learnedJutsus     CharacterJutsu[]
  jutsuUseLogs      JutsuUseLog[]
  duelsAsChallenger DuelEncounter[] @relation("DuelChallenger")
  duelsAsOpponent   DuelEncounter[] @relation("DuelOpponent")
  duelsWon          DuelEncounter[] @relation("DuelWinner")
  inventory         CharacterInventory[]
  currencyLogs      CurrencyLog[]

  @@unique([guildId, name])
  @@index([guildId, userId])
  @@map("characters")
}

model CharacterProgress {
  id             String   @id @default(cuid())
  guildId        String
  characterId    String   @unique
  trainingPoints Int      @default(0)
  currentChakra  Int?
  currency       Int      @default(0)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId])
  @@map("character_progress")
}

model TrainingLog {
  id           String   @id @default(cuid())
  guildId      String
  characterId  String
  actorId      String
  action       String
  attributeKey String?
  amount       Int      @default(0)
  cost         Int      @default(0)
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime @default(now())

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("training_logs")
}

model Clan {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  bonuses     Json     @default("{}")
  memberLimit Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("clans")
}

model Village {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  bonuses     Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("villages")
}

model RankDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  bonuses     Json     @default("{}")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("rank_definitions")
}

model PericiaDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progress   CharacterPericia[]
  xpLogs     PericiaXpLog[]
  jutsuTypes JutsuType[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("pericia_definitions")
}

model CharacterPericia {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  periciaId   String
  xp          Int      @default(0)
  level       Int      @default(1)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild     RpgGuild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  pericia   PericiaDefinition @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@unique([characterId, periciaId])
  @@index([guildId, characterId])
  @@map("character_pericias")
}

model PericiaXpLog {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  periciaId   String
  actorId     String
  xpGained    Int      @default(0)
  xpBefore    Int      @default(0)
  xpAfter     Int      @default(0)
  levelBefore Int      @default(1)
  levelAfter  Int      @default(1)
  reason      String?
  createdAt   DateTime @default(now())

  guild     RpgGuild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  pericia   PericiaDefinition @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("pericia_xp_logs")
}

model JutsuType {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  periciaId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild   RpgGuild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pericia PericiaDefinition? @relation(fields: [periciaId], references: [id], onDelete: SetNull)
  jutsus  JutsuDefinition[]

  @@unique([guildId, key])
  @@index([guildId])
  @@index([periciaId])
  @@map("jutsu_types")
}

model JutsuDefinition {
  id           String   @id @default(cuid())
  guildId      String
  key          String
  name         String
  description  String?
  typeId       String?
  jutsuRank    String?
  element      String?
  requirements String?
  imageUrl     String?
  externalId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild     RpgGuild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type      JutsuType?       @relation(fields: [typeId], references: [id], onDelete: SetNull)
  learnedBy CharacterJutsu[]
  useLogs   JutsuUseLog[]

  @@unique([guildId, key])
  @@unique([guildId, externalId])
  @@index([guildId])
  @@index([typeId])
  @@map("jutsu_definitions")
}

model CharacterJutsu {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  jutsuId     String
  learnedAt   DateTime @default(now())

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jutsu     JutsuDefinition @relation(fields: [jutsuId], references: [id], onDelete: Cascade)

  @@unique([characterId, jutsuId])
  @@index([guildId, characterId])
  @@map("character_jutsus")
}

model JutsuUseLog {
  id           String   @id @default(cuid())
  guildId      String
  characterId  String
  jutsuId      String
  actorId      String
  chakraCost   Int      @default(0)
  chakraBefore Int      @default(0)
  chakraAfter  Int      @default(0)
  createdAt    DateTime @default(now())

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jutsu     JutsuDefinition @relation(fields: [jutsuId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("jutsu_use_logs")
}

enum DuelStatus {
  PENDING
  ACTIVE
  ENDED
}

model DuelEncounter {
  id                    String     @id @default(cuid())
  guildId               String
  channelId             String
  challengerCharacterId String
  opponentCharacterId   String
  status                DuelStatus @default(PENDING)
  isForced              Boolean    @default(false)
  winnerCharacterId     String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  endedAt               DateTime?

  guild      RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  challenger Character @relation("DuelChallenger", fields: [challengerCharacterId], references: [id], onDelete: Cascade)
  opponent   Character @relation("DuelOpponent", fields: [opponentCharacterId], references: [id], onDelete: Cascade)
  winner     Character? @relation("DuelWinner", fields: [winnerCharacterId], references: [id], onDelete: SetNull)

  @@index([guildId, channelId, status])
  @@map("duel_encounters")
}

model ItemDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  price       Int?
  bonuses     Json     @default("{}")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild     RpgGuild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventory CharacterInventory[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("item_definitions")
}

model CharacterInventory {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  itemId      String
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild     RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      ItemDefinition  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([characterId, itemId])
  @@index([guildId, characterId])
  @@map("character_inventories")
}

model CurrencyLog {
  id             String   @id @default(cuid())
  guildId        String
  characterId    String
  actorId        String
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  reason         String?
  createdAt      DateTime @default(now())

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("currency_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("audit_logs")
}
