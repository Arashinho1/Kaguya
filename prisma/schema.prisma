generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  CHANNEL
  ROLE
  USER
}

model RpgGuild {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  prefix    String   @default(".")
  locale    String   @default("pt-BR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    GuildSetting[]
  permissions GuildRolePermission[]
  auditLogs   AuditLog[]
  attributes  AttributeDefinition[]
  characters  Character[]
  clans       Clan[]
  villages    Village[]
  ranks       RankDefinition[]
  progress    CharacterProgress[]
  trainingLogs TrainingLog[]
  periciaDefinitions PericiaDefinition[]
  characterPericias  CharacterPericia[]
  periciaXpLogs      PericiaXpLog[]

  @@map("rpg_guilds")
}

model GuildSetting {
  id          String          @id @default(cuid())
  guildId     String
  key         String
  label       String
  description String?
  value       Json
  valueType   ConfigValueType @default(JSON)
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("guild_settings")
}

model GuildRolePermission {
  id         String   @id @default(cuid())
  guildId    String
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId, permission])
  @@index([guildId])
  @@map("guild_role_permissions")
}

model AttributeDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  baseValue   Int      @default(0)
  minValue    Int      @default(0)
  maxValue    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, key])
  @@index([guildId])
  @@map("attribute_definitions")
}

model Character {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  name       String
  clanId     String?
  villageId  String?
  rankId     String?
  attributes Json     @default("{}")
  metadata   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guild   RpgGuild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clan    Clan?           @relation(fields: [clanId], references: [id], onDelete: SetNull)
  village Village?        @relation(fields: [villageId], references: [id], onDelete: SetNull)
  rank    RankDefinition? @relation(fields: [rankId], references: [id], onDelete: SetNull)
  progress          CharacterProgress?
  trainingLogs      TrainingLog[]
  periciaProgress   CharacterPericia[]
  periciaXpLogs     PericiaXpLog[]

  @@unique([guildId, name])
  @@index([guildId, userId])
  @@map("characters")
}

model CharacterProgress {
  id             String   @id @default(cuid())
  guildId        String
  characterId    String   @unique
  trainingPoints Int      @default(0)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId])
  @@map("character_progress")
}

model TrainingLog {
  id           String   @id @default(cuid())
  guildId      String
  characterId  String
  actorId      String
  action       String
  attributeKey String?
  amount       Int      @default(0)
  cost         Int      @default(0)
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime @default(now())

  guild     RpgGuild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("training_logs")
}

model Clan {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  bonuses     Json     @default("{}")
  memberLimit Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("clans")
}

model Village {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  bonuses     Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("villages")
}

model RankDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  bonuses     Json     @default("{}")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild      RpgGuild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("rank_definitions")
}

model PericiaDefinition {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild    RpgGuild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  progress CharacterPericia[]
  xpLogs   PericiaXpLog[]

  @@unique([guildId, key])
  @@index([guildId])
  @@map("pericia_definitions")
}

model CharacterPericia {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  periciaId   String
  xp          Int      @default(0)
  level       Int      @default(1)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild     RpgGuild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  pericia   PericiaDefinition @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@unique([characterId, periciaId])
  @@index([guildId, characterId])
  @@map("character_pericias")
}

model PericiaXpLog {
  id          String   @id @default(cuid())
  guildId     String
  characterId String
  periciaId   String
  actorId     String
  xpGained    Int      @default(0)
  xpBefore    Int      @default(0)
  xpAfter     Int      @default(0)
  levelBefore Int      @default(1)
  levelAfter  Int      @default(1)
  reason      String?
  createdAt   DateTime @default(now())

  guild     RpgGuild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  character Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  pericia   PericiaDefinition @relation(fields: [periciaId], references: [id], onDelete: Cascade)

  @@index([guildId, characterId, createdAt])
  @@map("pericia_xp_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  guild RpgGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("audit_logs")
}
